
% from pathlib import Path  % Python import removed — not valid in MATLAB

clear;
clc;
close all;

%% Plot every SPH CSV file in the current folder
% Expected filenames:
% partuni2D_dxh_0.833333.csv
% partuni2D_dxh_0.666667.csv
% partuni2D_dxh_0.555556.csv
% partuni2D_dxh_0.500000.csv
%
% The script creates:
% 1. One 2-D figure for PGauss, PCubic, and PWedn for every dx/h
% 2. One 2-D figure for all six gradient components for every dx/h
% 3. One 2-D figure for drhodtGauss, drhodtCubic, and drhodtWedn for every dx/h
% 4. One summary graph of L2 norm versus dx/h for the three kernels
% 5. PNG files saved automatically in MATLAB_plots

filePattern = 'partuni2D_dxh_*.csv';
outputFolder = 'MATLAB_plots';
saveFigures = true;

if saveFigures && ~exist(outputFolder,'dir')
    mkdir(outputFolder);
end

files = dir(filePattern);

if isempty(files)
    error('No files matching "%s" were found in the current folder.', ...
        filePattern);
end

nFiles = numel(files);

dxhValues = zeros(nFiles,1);
L2Gauss = zeros(nFiles,1);
L2Cubic = zeros(nFiles,1);
L2Wedn = zeros(nFiles,1);

fprintf('Found %d CSV files.\n',nFiles);

for n = 1:nFiles

    filename = files(n).name;
    fprintf('Reading %s\n',filename);

    %% Read metadata
    % Read whole file then validate that A1:C4 exists
    allCells = readcell(filename,'Delimiter',',');
    if size(allCells,1) < 4 || size(allCells,2) < 3
        error('File %s does not contain the expected metadata in range A1:C4.', filename);
    end
    metadata = allCells(1:4,1:3);

    dxh = metadata{1,2};
    dxhValues(n) = dxh;

    L2Gauss(n) = metadata{4,1};
    L2Cubic(n) = metadata{4,2};
    L2Wedn(n) = metadata{4,3};

    %% Read numerical data
    % Row 6 contains the variable names, so data begin at row 7.
    data = readmatrix(filename, ...
        'Delimiter',',', ...
        'NumHeaderLines',6);

    % Remove empty rows and separator rows.
    data = data(~all(isnan(data),2),:);

    if size(data,2) < 19
        error(['File %s has only %d columns. The script expects the ' ...
               '19-column CSV format produced by the C++ code.'], ...
               filename,size(data,2));
    end

    %% Extract variables according to the C++ CSV layout
    x = data(:,1);
    y = data(:,2);

    PGauss = data(:,4);
    PCubic = data(:,5);
    PWedn = data(:,6);

    dPGaussX = data(:,8);
    dPGaussY = data(:,9);

    dPCubicX = data(:,11);
    dPCubicY = data(:,12);

    dPWednX = data(:,14);
    dPWednY = data(:,15);

    drhodtGauss = data(:,17);
    drhodtCubic = data(:,18);
    drhodtWedn = data(:,19);

    %% Reconstruct the 2-D structured grid
    xUnique = unique(x);
    yUnique = unique(y);

    Nx = numel(xUnique);
    Ny = numel(yUnique);

    if Nx*Ny ~= numel(x)
        error(['The x-y coordinates in %s do not form a complete ' ...
               'structured grid.'],filename);
    end

    % The C++ output changes j (y) fastest and i (x) slowest.
    X = reshape(x,Ny,Nx)';
    Y = reshape(y,Ny,Nx)';

    PGaussGrid = reshape(PGauss,Ny,Nx)';
    PCubicGrid = reshape(PCubic,Ny,Nx)';
    PWednGrid = reshape(PWedn,Ny,Nx)';

    dPGaussXGrid = reshape(dPGaussX,Ny,Nx)';
    dPGaussYGrid = reshape(dPGaussY,Ny,Nx)';
    dPCubicXGrid = reshape(dPCubicX,Ny,Nx)';
    dPCubicYGrid = reshape(dPCubicY,Ny,Nx)';
    dPWednXGrid = reshape(dPWednX,Ny,Nx)';
    dPWednYGrid = reshape(dPWednY,Ny,Nx)';

    drhodtGaussGrid = reshape(drhodtGauss,Ny,Nx)';
    drhodtCubicGrid = reshape(drhodtCubic,Ny,Nx)';
    drhodtWednGrid = reshape(drhodtWedn,Ny,Nx)';

    dxhText = strrep(sprintf('%.6f',dxh),'.','p');

    %% =====================================================
    % FIGURE 1: Partition of unity
    % ======================================================
    figP = figure( ...
        'Name',sprintf('Partition of unity, dx/h = %.6f',dxh), ...
        'Position',[100 100 1500 470]);

    tiledlayout(1,3,'TileSpacing','compact','Padding','compact');

    pMin = min([PGauss;PCubic;PWedn]);
    pMax = max([PGauss;PCubic;PWedn]);

    nexttile;
    contourf(X,Y,PGaussGrid,30,'LineColor','none');
    axis equal tight;
    clim([pMin pMax]);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('P_{Gauss}');

    nexttile;
    contourf(X,Y,PCubicGrid,30,'LineColor','none');
    axis equal tight;
    clim([pMin pMax]);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('P_{Cubic}');

    nexttile;
    contourf(X,Y,PWednGrid,30,'LineColor','none');
    axis equal tight;
    clim([pMin pMax]);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('P_{Wendland}');

    sgtitle(sprintf('Partition of unity, dx/h = %.6f',dxh));

    if saveFigures
        exportgraphics(figP, ...
            fullfile(outputFolder, ...
            ['PartitionUnity_dxh_' dxhText '.png']), ...
            'Resolution',300);
    end

    %% =====================================================
    % FIGURE 2: Gradient components
    % ======================================================
    figGrad = figure( ...
        'Name',sprintf('Kernel gradients, dx/h = %.6f',dxh), ...
        'Position',[100 50 1000 900]);

    tiledlayout(3,2,'TileSpacing','compact','Padding','compact');

    % Use one symmetric colour range for all gradient components.
    gradMaximum = max(abs([ ...
        dPGaussX;dPGaussY; ...
        dPCubicX;dPCubicY; ...
        dPWednX;dPWednY]));

    if gradMaximum == 0
        gradMaximum = 1;
    end

    gradientLimits = [-gradMaximum gradMaximum];

    nexttile;
    contourf(X,Y,dPGaussXGrid,30,'LineColor','none');
    axis equal tight;
    clim(gradientLimits);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('dP_{Gauss}/dx');

    nexttile;
    contourf(X,Y,dPGaussYGrid,30,'LineColor','none');
    axis equal tight;
    clim(gradientLimits);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('dP_{Gauss}/dy');

    nexttile;
    contourf(X,Y,dPCubicXGrid,30,'LineColor','none');
    axis equal tight;
    clim(gradientLimits);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('dP_{Cubic}/dx');

    nexttile;
    contourf(X,Y,dPCubicYGrid,30,'LineColor','none');
    axis equal tight;
    clim(gradientLimits);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('dP_{Cubic}/dy');

    nexttile;
    contourf(X,Y,dPWednXGrid,30,'LineColor','none');
    axis equal tight;
    clim(gradientLimits);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('dP_{Wendland}/dx');

    nexttile;
    contourf(X,Y,dPWednYGrid,30,'LineColor','none');
    axis equal tight;
    clim(gradientLimits);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('dP_{Wendland}/dy');

    sgtitle(sprintf('Kernel-gradient sums, dx/h = %.6f',dxh));

    if saveFigures
        exportgraphics(figGrad, ...
            fullfile(outputFolder, ...
            ['GradientComponents_dxh_' dxhText '.png']), ...
            'Resolution',300);
    end

    %% =====================================================
    % FIGURE 3: Continuity drho/dt
    % ======================================================
    figRho = figure( ...
        'Name',sprintf('Continuity, dx/h = %.6f',dxh), ...
        'Position',[100 100 1500 470]);

    tiledlayout(1,3,'TileSpacing','compact','Padding','compact');

    rhoMin = min([drhodtGauss;drhodtCubic;drhodtWedn]);
    rhoMax = max([drhodtGauss;drhodtCubic;drhodtWedn]);

    nexttile;
    contourf(X,Y,drhodtGaussGrid,30,'LineColor','none');
    axis equal tight;
    clim([rhoMin rhoMax]);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('(d\rho/dt)_{Gauss}');

    nexttile;
    contourf(X,Y,drhodtCubicGrid,30,'LineColor','none');
    axis equal tight;
    clim([rhoMin rhoMax]);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('(d\rho/dt)_{Cubic}');

    nexttile;
    contourf(X,Y,drhodtWednGrid,30,'LineColor','none');
    axis equal tight;
    clim([rhoMin rhoMax]);
    colorbar;
    xlabel('x');
    ylabel('y');
    title('(d\rho/dt)_{Wendland}');

    sgtitle(sprintf('SPH continuity result, dx/h = %.6f',dxh));

    if saveFigures
        exportgraphics(figRho, ...
            fullfile(outputFolder, ...
            ['Continuity_dxh_' dxhText '.png']), ...
            'Resolution',300);
    end
end

%% =========================================================
% FIGURE 4: L2 norm versus dx/h
% ==========================================================

[dxhValues,order] = sort(dxhValues);

L2Gauss = L2Gauss(order);
L2Cubic = L2Cubic(order);
L2Wedn = L2Wedn(order);

figL2 = figure( ...
    'Name','L2 norm versus dx/h', ...
    'Position',[200 150 900 600]);

plot(dxhValues,L2Gauss,'-o','LineWidth',1.5,'MarkerSize',7);
hold on;
plot(dxhValues,L2Cubic,'-s','LineWidth',1.5,'MarkerSize',7);
plot(dxhValues,L2Wedn,'-^','LineWidth',1.5,'MarkerSize',7);
hold off;

grid on;
box on;
xlabel('dx/h');
ylabel('L_2 norm');
title('Partition-of-unity L_2 error versus dx/h');
legend('Gaussian','Cubic spline','Wendland C2', ...
    'Location','best');

if saveFigures
    exportgraphics(figL2, ...
        fullfile(outputFolder,'L2norm_vs_dxh.png'), ...
        'Resolution',300);
end

%% Save and display the summary values
summaryTable = table( ...
    dxhValues,L2Gauss,L2Cubic,L2Wedn, ...
    'VariableNames', ...
    {'dx_over_h','L2_Gaussian','L2_Cubic','L2_Wendland'});

disp(summaryTable);

if saveFigures
    writetable(summaryTable, ...
        fullfile(outputFolder,'L2norm_summary.csv'));
end

fprintf('\nAll plots have been created.\n');
fprintf('Results are saved in the folder: %s\n',outputFolder);


output_path = Path('/mnt/data/plot_all_SPH_2D.m');
output_path.write_text(matlab_code, encoding='utf-8')

fprintf('Created: %s\n', char(output_path));
